using "ui/basic.style";
using "ui/colors.palette";
using "ui/widgets/widgets.style";
using "ui/menu_icons.style";
using "dialogs/dialogs.style";
using "info/info.style";

iconPreviewStroke: activeButtonBg;

cpPadding: 14px;
cpSelectedPadding: 2px;
cpPenSize: 2px;
cpImagePadding: 4px;
cpSpacingX: 16px;
cpSpacingY: 8px;
cpIconSize: 64px;

rndPreviewFill: historyPeerArchiveUserpicBg;
rndSkeletonFill: windowBgOver;

rndPreviewSize: 48px;
rndPenSize: 2px;

stickerPreviewTimeWidth: 36px;
stickerPreviewTimeHeight: 18px;
stickerSpacefillerHeight: 28px;
stickerMargins: 12px;

topBarAdmins: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "menu/admin", menuIconFg }};
	iconOver: icon {{ "menu/admin", menuIconFgOver }};
	iconPosition: point(8px, 15px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

topBarRecentActions: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "menu/group_log", menuIconFg }};
	iconOver: icon {{ "menu/group_log", menuIconFgOver }};
	iconPosition: point(8px, 15px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

faContextMenu: PopupMenu(popupMenuWithIcons) {
	radius: 8px;
}

settingsSliderRestore: IconButton(defaultIconButton) {
	width: 20px;
	height: 20px;

	icon: icon {{ "menu/restore", menuIconFg }};
	iconOver: icon {{ "menu/restore", menuIconFgOver }};
	iconPosition: point(0px, 0px);

	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 20px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

faBadgeToast: Toast(defaultToast) {
	minWidth: 200px;
	maxWidth: 360px;
	padding: margins(18px, 14px, 18px, 14px);
}
faBadgeToastBadge: InfoPeerBadge(infoPeerBadge) {
	premiumFg: toastFg;
}

infoFAgramOfficialBadge: icon {{ "fa/fagram_official", profileVerifiedCheckBg }};
infoFAgramSupporterBadge: icon {{ "fa/fagram_badge", profileVerifiedCheckBg }};

dialogsFAgramOfficialIcon: ThreeStateIcon {
	icon: icon {{ "fa/dialogs_fagram_official", dialogsVerifiedIconBg }};
	over: icon {{ "fa/dialogs_fagram_official", dialogsVerifiedIconBgOver }};
	active: icon {{ "fa/dialogs_fagram_official", dialogsVerifiedIconBgActive }};
}
dialogsFAgramSupporterIcon: ThreeStateIcon {
	icon: icon {{ "fa/dialogs_fagram_supporter", dialogsVerifiedIconBg }};
	over: icon {{ "fa/dialogs_fagram_supporter", dialogsVerifiedIconBgOver }};
	active: icon {{ "fa/dialogs_fagram_supporter", dialogsVerifiedIconBgActive }};
}



